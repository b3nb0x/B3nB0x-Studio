# B3nBox Studio - LLM Manager Konfiguration
# Kopiere diese Datei nach config/b3nbox.toml und passe sie an.

[server]
host = "127.0.0.1"   # fuer Netzwerkzugriff: "0.0.0.0"
port = 8300

# --- HTTPS ---
# https = true: TLS aktiv
#   - Ohne cert_path/key_path: Self-Signed-Zertifikat wird automatisch
#     generiert (data/certs/) - ideal fuer lokale Nutzung
#   - Mit Domaeene (Let's Encrypt): certbot certonly -d deine.domaene.de
#     und Pfade auf /etc/letsencrypt/live/<domain>/ setzen
# https = false
# cert_path = "/etc/letsencrypt/live/deine.domaene.de/fullchain.pem"
# key_path = "/etc/letsencrypt/live/deine.domaene.de/privkey.pem"

# --- LLM Backends (Adapter) ---
# type: ollama | llamacpp | lmstudio | native

[backends.ollama]
type = "ollama"
url = "http://127.0.0.1:11434"

[backends.llamacpp]
type = "llamacpp"
url = "http://127.0.0.1:8080"

[backends.lmstudio]
type = "lmstudio"
url = "http://127.0.0.1:1234"

[backends.native]
type = "native"
# Pfad zu einem GGUF-Modell für den eingebauten B3nBox-Native-Adapter
# model_path = "/pfad/zu/modell.gguf"

# --- Routing: Route-Key -> Backend + Modell ---
# Route-Keys: "default", Pipeline-Phasen (analyse, plan, implement, control)
# und eigene Task-Typen (z.B. "scheduler").

[routing.default]
backend = "ollama"
model = "qwen2.5-coder:7b"

[routing.analyse]
backend = "ollama"
model = "llama3.1:8b"

[routing.plan]
backend = "ollama"
model = "llama3.1:8b"

[routing.implement]
backend = "ollama"
model = "qwen2.5-coder:14b"

[routing.control]
backend = "llamacpp"
model = "qwen2.5-coder-14b-q4_k_m"

[routing.scheduler]
backend = "ollama"
model = "llama3.1:8b"

# Route fuer Embeddings (semantische Memory-Suche + auto-Embedding)
[routing.embeddings]
backend = "ollama"
model = "nomic-embed-text"

# Route fuer den Agenten (Tool-Use)
[routing.agent]
backend = "ollama"
model = "qwen2.5:14b"

# --- Memory-Layer ---

[memory]
enabled = true
db_path = "data/b3nbox-memory.db"

# --- Permission-System ---
# mode: "default-allow" (alles erlaubt, Ausnahmen via deny)
#       "default-deny" (alles verboten, Ausnahmen via allow)
# actions: chat, pipeline, task, script | scope: Route bzw. Skript-Pfad

[permissions]
mode = "default-allow"

# Beispiel: Pipeline nur mit Freigabe, Skripte nur aus ./scripts
# [[permissions.rules]]
# effect = "deny"
# action = "pipeline"
#
# [[permissions.rules]]
# effect = "allow"
# action = "script"
# scope = "scripts"

# --- MCP-Server (Model Context Protocol, JSON-RPC über stdio) ---

# [mcp.filesystem]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/pfad/zum/projekt"]
#
# [mcp.git]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-git"]

# --- Skripte & Scheduler ---
# Skripte nur aus erlaubten Verzeichnissen, Ausführung nur mit Freigabe

[scripts]
allowed_dirs = ["scripts"]
require_approval = true

# --- Sessions & Audit ---

[sessions]
enabled = true
db_path = "data/b3nbox-sessions.db"

[audit]
enabled = true
db_path = "data/b3nbox-audit.db"

# --- Injection-Guard ---
# mode: "block" (Injektionen werden blockiert) | "log-only" (nur loggen)
# llm_check: zusaetzlicher LLM-Klassifikator bei Verdacht (Phase 5)

[guard]
enabled = true
mode = "block"
# LLM-Klassifikator als Zweitmeinung bei Scanner-Verdacht (Schicht 4)
# Benoetigt Route 'injection-detector' (kleines, schnelles Modell)
llm_check = false
detector_route = "injection-detector"

# --- Rate-Limiting ---
# Token-Bucket pro Client (identifiziert ueber API-Key-Name).
# LLM-Endpunkte (chat, pipeline, agent, sessions) haben ein eigenes,
# niedrigeres Limit. Admin kann zur Laufzeit anpassen:
# POST /v1/rate-limit {"requests_per_minute": 150, "llm_requests_per_minute": 30}

[rate_limit]
enabled = true
requests_per_minute = 150
llm_requests_per_minute = 30

# --- Authentifizierung ---
# Key generieren: ./target/release/b3nbox-server --generate-key
# Es wird NUR der Hash gespeichert, niemals der Key selbst.
# Rollen: "admin" (alles erlaubt) | "user" (Schreib-Rechte nur ausserhalb
#         der Admin-Pfade: permissions/scripts/schedule/rate-limit)

[auth]
enabled = true

[[auth.keys]]
name = "admin-key"
role = "admin"
key_hash = "HIER_DEN_HASH_EINFUEGEN"

# [[auth.keys]]
# name = "gui-user"
# role = "user"
# key_hash = "..."

# Beispiel-Konfiguration fuer den Klassifikator:
# [routing.injection-detector]
# backend = "ollama"
# model = "llama3.2:3b"
